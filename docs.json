        "pages": [
          "grow/sharing",
          "grow/leaderboard",
          "grow/invites",
          "grow/templates",
          "grow/affiliate",
          "grow/page-payments"
        ]
      },
      {
        "group": "Premium",
        "pages": [
          "premium/overview",
          "premium/store"
        ]
      },
      {
        "group": "Account and settings",
        "pages": [
          "account/settings",
          "account/switch-accounts",
          "account/support"
        ]
      },
      {
        "group": "Discord bot",
        "pages": [
          "discord-bot/commands"
        ]
