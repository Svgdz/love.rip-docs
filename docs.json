    "primary": "#FB047A",
    "light": "#FF5FA8",
    "dark": "#C80362"
  },
  "appearance": {
    "default": "dark"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.love.rip"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "Discord",
        "href": "https://discord.gg/loverip"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open love.rip",
      "href": "https://www.love.rip"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "getting-started/create-account",
          "getting-started/dashboard-tour"
        ]
      },
      {
        "group": "Profile",
        "pages": [
          "profile/profile-details",
          "profile/media",
          "profile/layout",
          "profile/style",
          "profile/effects",
          "profile/enter-screen",
          "profile/metadata",
          "profile/couples",
          "profile/multiple-profiles"
        ]
      },
      {
        "group": "Links and widgets",
        "pages": [
          "links-and-widgets/links",
          "links-and-widgets/widgets",
          "links-and-widgets/section-builder"
